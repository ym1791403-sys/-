{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/images/(.*)", "destination": "/frontend/images/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/privacy", "destination": "/frontend/privacy.html" },
    { "source": "/privacy.html", "destination": "/frontend/privacy.html" },
    { "source": "/terms", "destination": "/frontend/privacy.html" },
    { "source": "/returns", "destination": "/frontend/privacy.html" }
  ]
}
